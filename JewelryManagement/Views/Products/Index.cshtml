@model IEnumerable<JewelryManagement.Models.Product>

@{
    ViewData["Title"] = "飾品商品管理";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1 style="color:#9C7183; font-weight:bold;">
            飾品銷售網站管理系統
        </h1>

        <p class="text-muted">
            Jewelry Product Management System
        </p>
    </div>

    <hr />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 style="color:#9C7183;">商品管理列表</h4>

        <a asp-action="Create"
           class="btn text-white"
           style="background-color:#B98598;">
            + 新增飾品
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead style="background-color:#F5E8ED;">
                <tr>
                    <th>商品名稱</th>
                    <th>商品分類</th>
                    <th>商品價格</th>
                    <th>庫存數量</th>
                    <th>商品描述</th>
                    <th>功能操作</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Category</td>
                        <td>NT$ @item.Price.ToString("N0")</td>
                        <td>@item.Stock</td>
                        <td>@item.Description</td>

                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    詳細資料
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    修改
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    刪除
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
